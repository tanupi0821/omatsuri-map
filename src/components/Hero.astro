---
/**
 * トップの絵。**縁日・盆踊り・花火の三要素**を奥行きで重ねる。
 *
 * 絵は 3 層に分けて別々に置く。1 枚を `preserveAspectRatio="slice"` で
 * 敷くと、横に広い画面では縦も一緒に拡大されて上半分が切り落とされ、
 * 花火と櫓が画面外に消える（横 1900px で実際にそうなった）。
 *   .fw     花火    … 右上に固定
 *   .yag    櫓      … 右下、屋台の後ろ
 *   .ground 縁日    … 下端の帯。横に伸びても屋台が並び続ける
 *
 * 写真は 4093 件中 184 件（4.5%）にしか無い。写真前提の骨格には
 * できないので、絵で祭りの気配を出す。外部画像は読み込まない。
 */
import { loadFestivals, latestOccurrence } from '../lib/data.js';

const festivals = loadFestivals();
const today = new Date().toISOString().slice(0, 10);

/**
 * **「今週末」はビルド時に決めてはいけない。**
 * 月曜にビルドして金曜に見られたら、先週末の件数を出すことになる。
 * 日付ごとの件数だけ渡して、金土日の判定と合計は見る側で行う。
 */
const dateCounts = {};
for (const f of festivals) {
  for (const d of latestOccurrence(f)?.dates ?? []) {
    if (d >= today) dateCounts[d] = (dateCounts[d] ?? 0) + 1;
  }
}

const cities = new Set(festivals.map((f) => `${f._prefSlug}/${f._citySlug}`)).size;
const prefs = new Set(festivals.map((f) => f._prefSlug)).size;
const machi = festivals.filter((f) => f.scale === '町内会').length;
const stalls = festivals.filter((f) => f.stalls === 'yes').length;

// JS が動かないときのための控え。ビルド時点の直近の週末で埋めておく
const d0 = new Date(`${today}T00:00:00+09:00`);
const dow = d0.getDay();
const fri = new Date(d0);
fri.setDate(d0.getDate() + (dow === 0 ? -2 : (5 - dow + 7) % 7));
const wk = [0, 1, 2].map((i) => {
  const x = new Date(fri);
  x.setDate(fri.getDate() + i);
  return x.toISOString().slice(0, 10);
});
const fallback = wk.reduce((s, d) => s + (dateCounts[d] ?? 0), 0);
const fmt = (d) => `${Number(d.slice(5, 7))}月${Number(d.slice(8, 10))}日`;
