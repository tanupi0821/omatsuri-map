<script type="application/json" id="js-datecounts" set:html={JSON.stringify(dateCounts)} />
<script>
  // 直近の金・土・日。金曜の夜も祭りは多いので金曜から数える。
  // 日曜に見ている人にとっての「今週末」は、始まっている今の週末
  const el = document.getElementById('js-datecounts');
  if (el) {
    const counts = JSON.parse(el.textContent || '{}');
    const iso = (d) => {
      const z = new Date(d.getTime() - d.getTimezoneOffset() * 60000);
      return z.toISOString().slice(0, 10);
    };
    const now = new Date();
    const dow = now.getDay();
    const fri = new Date(now);
    fri.setDate(now.getDate() + (dow === 0 ? -2 : (5 - dow + 7) % 7));
    const days = [0, 1, 2].map((i) => {
      const x = new Date(fri);
      x.setDate(fri.getDate() + i);
      return iso(x);
    });
    const n = days.reduce((s, d) => s + (counts[d] ?? 0), 0);
    const f = (d) => `${Number(d.slice(5, 7))}月${Number(d.slice(8, 10))}日`;
    const nEl = document.querySelector('.js-wn');
    const kEl = document.querySelector('.js-wk');
    if (nEl) nEl.innerHTML = `${n}<small>件</small>`;
    if (kEl) kEl.textContent = `${f(days[0])}(金)〜${f(days[2])}(日)に開催される祭り`;
  }
</script>

<style>
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    background:
      radial-gradient(1px 1px at 18% 22%, rgba(255,255,255,.55) 0 100%, transparent 0),
      radial-gradient(1px 1px at 86% 30%, rgba(255,255,255,.45) 0 100%, transparent 0),
      linear-gradient(180deg, #0b1526 0%, #132c48 58%, #1d3f63 100%);
    color: #fdf6e6; border-bottom: 2px solid var(--ai);
  }
  /* 絵の 3 層。切り抜きに頼らず、それぞれ固定の位置と大きさで置く */
  .fw { position: absolute; top: 0; right: 2%; width: min(340px, 42%); height: auto; z-index: 0; opacity: .95; }
  .yag { position: absolute; right: 3%; bottom: 34px; width: min(200px, 26%); height: auto; z-index: 0; }
  .ground { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 132px; z-index: 0; }
  /* 文字を読ませる暗幕と、縁日の暖かさ。::after は絵より後に描かれる */
  .hero::after {
    content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(11,21,38,.9) 0%, rgba(11,21,38,.5) 46%, rgba(11,21,38,0) 76%),
      radial-gradient(130% 90% at 50% 100%, rgba(255,176,80,.34), transparent 68%);
  }
  /* 下端は縁日の帯。文字がそこへ落ちない高さだけ確保する。
     広い画面で余白まで伸びると、一覧に着くまでのスクロールが増える */
  .hero .wrap {
    position: relative; z-index: 1;
    padding-top: var(--s4); padding-bottom: clamp(104px, 7vw, 138px);
  }
  .hero h1 { margin: 0; font-size: var(--d1); line-height: 1.35; letter-spacing: .03em; font-weight: 800; }
  .hero h1 em { font-style: normal; color: #ffd98a; }
  .hero .sub { margin: var(--s3) 0 0; font-size: var(--d2); color: #cfe0f0; line-height: 1.65; max-width: 46em; }

  /* 今週末の件数。「今週末どこで祭りがあるか」への最短動線 */
  .weekend {
    display: inline-flex; align-items: stretch; max-width: 100%;
    margin: var(--s4) 0 0; text-decoration: none; color: inherit;
    border: 1px solid rgba(255,214,140,.45); border-radius: var(--r2);
    overflow: hidden; background: rgba(255,205,120,.12);
  }
  .weekend .tate {
    writing-mode: vertical-rl; text-orientation: upright; letter-spacing: .22em;
    /* 夜空の上なのでライト／ダーク問わず濃い茜で固定する */
    background: #b02730; color: #fff; font-weight: 700; font-size: var(--d4);
    padding: var(--s3) var(--s1); display: flex; align-items: center; justify-content: center; flex: 0 0 auto;
  }
  .weekend .body { padding: var(--s2) var(--s3); flex: 1; min-width: 0; }
  .weekend .n { display: block; font-size: var(--d3); font-weight: 800; color: #ffd98a; line-height: 1.05; }
  .weekend .n small { font-size: var(--d4); font-weight: 700; margin-left: 3px; }
  .weekend .k { font-size: var(--d4); color: #e8f0f8; display: block; margin-top: 2px; }
  .weekend .go {
    align-self: center; flex: 0 0 auto; padding: 0 var(--s4) 0 var(--s2);
    font-size: var(--d2); font-weight: 700; color: #ffd98a; white-space: nowrap;
  }
  .herostats {
    margin: var(--s3) 0 0; font-size: var(--d4); color: #b9cde0;
    display: flex; flex-wrap: wrap; gap: var(--s1) var(--s4);
  }
  .herostats b { color: #fdf6e6; font-weight: 700; }
  /* **スマホは文字が全幅に広がる。** 横方向の暗幕は、文字が左・絵が右に
     分かれる広い画面でしか効かない。狭い画面では見出しの右端が明るい花火の
     上に素通しで乗ってしまうので、暗幕を縦方向（上が濃い）に切り替える */
  @media (max-width: 600px) {
    .hero::after {
      background:
        linear-gradient(180deg, rgba(11,21,38,.86) 0%, rgba(11,21,38,.62) 46%, rgba(11,21,38,.1) 78%),
        radial-gradient(150% 70% at 50% 100%, rgba(255,176,80,.36), transparent 66%);
    }
    /* 花火は見出しと重なるので、上ではなく空の余白へ寄せて小さくする */
    .fw { width: 46%; right: -2%; top: -6px; opacity: .7; }
    .yag { width: 26%; right: -1%; bottom: 4px; opacity: .75; }
    .ground { height: 108px; }
    .hero .wrap { padding-top: var(--s3); padding-bottom: 100px; }
    /* 幅いっぱいに置いて、端の揃わない見た目をなくす */
    .weekend { display: flex; width: 100%; }
    .weekend .go { padding: 0 var(--s3) 0 var(--s1); }
    .herostats { gap: var(--s1) var(--s3); font-size: var(--t1); max-width: 74%; }
  }
</style>
