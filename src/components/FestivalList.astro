---
/**
 * 祭りの一覧（絞り込みつき）
 *
 * トップ・都道府県ページ・市区町村ページで使い回す。
 *
 * **1 ページに全国 3916 件を出すとトップが 2.9MB になった。**
 * 携帯で開ける大きさではないので、ページを地域で割って
 * それぞれが扱う件数を絞る。この部品は渡された分だけを描く。
 */
import { latestOccurrence, formatDates, formatTime, STATUS_LABEL } from '../lib/data.js';

const { festivals, showArea = true } = Astro.props;

const kinds = [...new Set(festivals.map((f) => f.kind))].sort();
const hasStalls = festivals.some((f) => f.stalls === 'yes');

// 月の選択肢は実際に開催のある月だけ出す。1 つしか無ければ絞る意味がない
const months = [...new Set(
  festivals.flatMap((f) => (latestOccurrence(f)?.dates ?? []).map((d) => d.slice(0, 7))),
)].sort();

// 木札に出す日付の部品。月・日・曜日に割って、複数日は「+N日」で畳む。
// 数百件並ぶので、一覧では 1 件 1 行に収める
const WD = ['日', '月', '火', '水', '木', '金', '土'];
function chip(o) {
  const d = o?.dates?.[0];
  if (!d) return null;
  const t = new Date(`${d}T00:00:00+09:00`);
  return {
    m: `${Number(d.slice(5, 7))}月`,
    n: Number(d.slice(8, 10)),
    w: WD[t.getDay()],
    dow: t.getDay(),
    plus: (o.dates?.length ?? 1) - 1,
    // 例祭日から割り出した推定日は、確定した日程と見分けが付くようにする
    est: o.status === 'estimated',
  };
}

const SOURCE_TIER = { official: '公式', gov: '行政', media: '媒体', aggregator: 'まとめ' };

const rows = festivals.map((f) => {
  const o = latestOccurrence(f);
  return {
    f,
    o,
    chip: chip(o),
    start: o?.dates?.[0] ?? null,
    end: o?.dates?.at(-1) ?? o?.dates?.[0] ?? null,
    dateLabel: formatDates(o),
    timeLabel: formatTime(o),
    statusLabel: STATUS_LABEL[o?.status] ?? null,
  };
});
---

<div class="filters">
  <div class="tabs" role="group" aria-label="表示する期間">
    <button data-range="upcoming" class="on">これから</button>
    <button data-range="weekend">今週末</button>
    <button data-range="all">すべて</button>
  </div>
  <div class="selects">
    <select class="js-kind" aria-label="種別で絞り込む">
      <option value="">種別：すべて</option>
      {kinds.map((k) => <option value={k}>{k}</option>)}
    </select>
    {months.length > 1 && (
      <select class="js-month" aria-label="月で絞り込む">
        <option value="">月：すべて</option>
        {months.map((m) => <option value={m}>{Number(m.slice(5))}月</option>)}
      </select>
    )}
    {hasStalls && (
      <label class="stalls-toggle">
        <input type="checkbox" class="js-stalls" />
        屋台あり
      </label>
    )}
  </div>
</div>

{/* 町内会の祭りは名前で探されることが多い（「◯◯町会」「◯◯公園」）。
    件数が少ないページでは邪魔になるだけなので出さない。 */}
{festivals.length > 20 && (
  <input
    class="js-q search"
    type="search"
    placeholder="祭りの名前・会場・町会名でしぼる"
    aria-label="祭りの名前や会場で探す"
  />
)}

<p class="count js-count"></p>
<p class="lede js-empty" hidden>
  条件に合う祭りがありません。「すべて」に切り替えると過去の開催回も見られます。
</p>

<ul class="list js-list">
  {rows.map(({ f, o, chip, start, end, dateLabel, timeLabel, statusLabel }) => (
    <li
      class:list={['row', f.stalls === 'yes' && 'yatai']}
      data-kind={f.kind}
      data-stalls={f.stalls ?? 'unknown'}
      data-start={start}
      data-end={end}
      data-dates={(o?.dates ?? []).join(',')}
      data-q={[f.name, f.venue.name, f.organizer, f.shrine, f.area.city, f.area.ward]
        .filter(Boolean).join(' ')}
    >
      <a href={`/f/${f.id}/`}>
        {chip ? (
          <span class:list={['d', chip.dow === 6 && 'sat', chip.dow === 0 && 'sun', chip.est && 'est']}>
            <span class="m">{chip.m}</span>
            <span class="n">{chip.n}</span>
            <span class="w">{chip.w}</span>
            {chip.plus > 0 && <span class="plus">+{chip.plus}日</span>}
          </span>
        ) : (
          <span class="d none"><span class="m">日程</span><span class="w">未確認</span></span>
        )}
        <span class="rbody">
          <span class="rname">{f.name}</span>
          <span class="rmeta">
            <span class="badge">{f.kind}</span>
            {f.stalls === 'yes' && <span class="badge stalls">屋台</span>}
            {statusLabel && <span class="badge warn">{statusLabel}</span>}
            {timeLabel && <span class="rtime">{timeLabel}</span>}
            {showArea && <span>{f.area.city}{f.area.ward ? ` ${f.area.ward}` : ''}</span>}
            <span class="sep">/</span>
            <span>{f.venue.name}</span>
          </span>
          {/* 出典と最終確認日は全ページに出す方針。一覧でも 1 行入れる。
              格と確認日は必ず先に置いて切らせない。はみ出すのは出典名の末尾だけ */}
          <span class="rsrc">
            <span class:list={['tier', o?.source_type === 'official' && 'official',
                               o?.source_type === 'aggregator' && 'agg']}>
              {SOURCE_TIER[o?.source_type] ?? '出典'}
            </span>
            {o?.checked_at} 確認／{o?.source_name ?? '出典'}
          </span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: var(--s2); margin: var(--s5) 0 var(--s3); }
  .tabs { display: flex; border: 1px solid var(--line); border-radius: var(--r2); overflow: hidden; background: var(--card); }
  .tabs button {
    border: 0; background: transparent; color: var(--fg);
    padding: var(--s1) var(--s3); font-size: var(--t3); cursor: pointer; font-family: inherit;
  }
  .tabs button + button { border-left: 1px solid var(--line); }
  .tabs button.on { background: var(--akane); color: #fff; font-weight: 700; }
  @media (prefers-color-scheme: dark) { .tabs button.on { color: #2a0d0c; } }
  .selects { display: flex; gap: var(--s2); flex: 1; min-width: 190px; }
  select {
    flex: 1; min-width: 0; padding: var(--s1) var(--s2); font-size: var(--t3); font-family: inherit;
    border: 1px solid var(--line); border-radius: var(--r2);
    background: var(--card); color: var(--fg);
  }
  .count { font-size: var(--t2); color: var(--muted); margin: 0 0 var(--s1); }
  .search {
    width: 100%; margin: 0 0 var(--s2); padding: var(--s2) var(--s3);
    font-size: var(--t4); font-family: inherit;
    border: 1px solid var(--line); border-radius: var(--r2);
    background: var(--card); color: var(--fg);
  }
  .lede { color: var(--muted); font-size: var(--t3); }
  /* 屋台の有無は最重要。トグル自体を提灯色にして、押せることを強く出す */
  .stalls-toggle {
    display: flex; align-items: center; gap: var(--s1); font-size: var(--t3);
    padding: var(--s1) var(--s3); border: 1px solid var(--stall); border-radius: var(--r2);
    background: var(--stall-bg); color: var(--stall); font-weight: 700;
    cursor: pointer; white-space: nowrap;
  }

  /* 一覧は 1 件あたりの高さが命。市区町村ページには数百件並ぶ。
     カード（1 件 150px 前後）をやめて行にし、高さを揃えて目で追えるようにした */
  .list {
    list-style: none; padding: 0; margin: 0; background: var(--card);
    border: 1px solid var(--line); border-radius: var(--r2); overflow: hidden;
  }
  .row { border-bottom: 1px solid var(--line2); position: relative; }
  .row:last-child { border-bottom: 0; }
  .row > a {
    display: flex; gap: var(--s2); padding: var(--s2);
    text-decoration: none; color: inherit;
  }
  .row:hover { background: var(--card2); }
  /* 夜店の灯り。屋台が出ると分かっている祭りだけ、左から暖色がにじむ。
     スクロール中に「灯っている行」が目に入る。装飾ではなく情報 */
  .row.yatai { background: linear-gradient(90deg, var(--glow) 0, transparent 150px); }
  .row.yatai:hover { background: linear-gradient(90deg, var(--glow) 0, transparent 220px); }

  /* 木札の日付。土=藍 日=茜。推定日は破線で、確定した日程と区別する */
  .d {
    flex: 0 0 46px; width: 46px; text-align: center; padding: 2px 0 3px;
    border-radius: var(--r1); background: var(--wood); border: 1px solid var(--line);
    align-self: flex-start; line-height: 1.15;
  }
  .d .m { display: block; font-size: var(--t1); color: var(--muted); }
  .d .n { display: block; font-size: var(--t5); font-weight: 800; font-variant-numeric: tabular-nums; }
  .d .w { display: block; font-size: var(--t1); color: var(--muted); }
  .d.sat .n, .d.sat .w { color: var(--ai); }
  .d.sun .n, .d.sun .w { color: var(--akane); }
  .d.est { border-style: dashed; border-color: var(--warn-line); background: transparent; }
  .d.none { padding: var(--s2) 0; }
  .d .plus { display: block; font-size: var(--t1); color: var(--muted); }

  .rbody { flex: 1; min-width: 0; }
  .rname { display: block; font-size: var(--t4); font-weight: 700; line-height: 1.3; word-break: break-word; }
  /* 種別・屋台・時間・地域・会場を 1 本にまとめる。数百件並ぶので行数を増やさない */
  .rmeta {
    display: flex; flex-wrap: wrap; gap: 0 var(--s1); align-items: center;
    font-size: var(--t2); color: var(--muted); line-height: 1.5;
  }
  .rmeta .sep { opacity: .45; }
  .rtime { font-size: var(--t2); color: var(--fg); font-weight: 600; font-variant-numeric: tabular-nums; }
  /* 出典と最終確認日は 1 行に固定し、はみ出すのは出典名の末尾だけにする */
  .rsrc {
    display: block; font-size: var(--t1); color: var(--muted); line-height: 1.4;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .rsrc .tier {
    display: inline-block; border: 1px solid var(--line); border-radius: var(--r1);
    padding: 0 var(--s1); margin-right: var(--s1);
  }
  .rsrc .tier.official { border-color: var(--ai); color: var(--ai); }
  .rsrc .tier.agg { border-color: var(--warn-line); color: var(--warn-fg); }
</style>

<script>
  // 静的サイトなので日付判定はブラウザ側で行う。
  // ビルドが古くても「今週末」が狂わないようにするため。
  const list = document.querySelector('.js-list');
  const cards = [...document.querySelectorAll('.row')];
  const tabs = [...document.querySelectorAll('.tabs button')];
  const kind = document.querySelector('.js-kind');
  const month = document.querySelector('.js-month');
  const stalls = document.querySelector('.js-stalls');
  const q = document.querySelector('.js-q');
  const empty = document.querySelector('.js-empty');
  const count = document.querySelector('.js-count');
  let range = 'upcoming';

  const iso = (d) => d.toISOString().slice(0, 10);
  const today = iso(new Date());

  // 今週末＝直近の金・土・日（金曜の夜も祭りは多いので金曜から含める）
  function weekendRange() {
    const now = new Date();
    const dow = now.getDay(); // 0=日
    const toFri = (5 - dow + 7) % 7;
    const fri = new Date(now);
    fri.setDate(now.getDate() + (dow === 0 ? -2 : toFri));
    const sun = new Date(fri);
    sun.setDate(fri.getDate() + 2);
    return [iso(fri), iso(sun)];
  }

  // 縁日のように何日も開催が続くものは、初日ではなく「次にある日」で並べたい
  function nextDate(c) {
    const dates = c.dataset.dates ? c.dataset.dates.split(',') : [];
    return dates.find((d) => d >= today) ?? c.dataset.end ?? c.dataset.start ?? '9999';
  }

  function apply() {
    const [wStart, wEnd] = weekendRange();
    const words = (q?.value ?? '').trim().toLowerCase().split(/\s+/).filter(Boolean);
    const visible = [];
    for (const c of cards) {
      const s = c.dataset.start;
      const e = c.dataset.end || s;
      let ok = true;
      if (kind.value && c.dataset.kind !== kind.value) ok = false;
      // 月は開催日のどれかがその月なら通す（月をまたぐ祭りがある）
      if (ok && month?.value) {
        ok = (c.dataset.dates || '').split(',').some((d) => d.startsWith(month.value));
      }
      // 「屋台あり」は確認できたものだけ。未確認(unknown)は出さない
      if (ok && stalls?.checked && c.dataset.stalls !== 'yes') ok = false;
      if (ok && words.length) {
        const hay = (c.dataset.q || '').toLowerCase();
        ok = words.every((w) => hay.includes(w));
      }
      if (ok && range === 'upcoming') ok = !!e && e >= today;
      if (ok && range === 'weekend') ok = !!s && s <= wEnd && e >= wStart;
      c.hidden = !ok;
      if (ok) visible.push(c);
    }

    if (range !== 'all') {
      visible.sort((a, b) => nextDate(a).localeCompare(nextDate(b)));
      for (const c of visible) list.appendChild(c);
    }

    empty.hidden = visible.length > 0;
    count.textContent = `${visible.length} 件`;
  }

  for (const t of tabs) {
    t.addEventListener('click', () => {
      tabs.forEach((x) => x.classList.toggle('on', x === t));
      range = t.dataset.range;
      apply();
    });
  }
  kind.addEventListener('change', apply);
  // 月を選んだのに「これから」のままだと、過ぎた月を選んだ人に 0 件が出る。
  // 月で探す人は期間を気にしていないので、こちらで「すべて」に切り替える
  month?.addEventListener('change', () => {
    if (month.value && range !== 'all') {
      range = 'all';
      tabs.forEach((x) => x.classList.toggle('on', x.dataset.range === 'all'));
    }
    apply();
  });
  stalls?.addEventListener('change', apply);
  q?.addEventListener('input', apply);

  // 掲載が数件しかない市区町村では、既定の「これから」で 0 件になることが多い
  // （765 市区町村のうち 249 で発生していた）。開いた瞬間「条件に合う祭りが
  // ありません」しか出ないページは、中身が無いページに見える。
  // 初回だけ、0 件なら「すべて」に落として過去の開催回を見せる
  apply();
  if (!cards.some((c) => !c.hidden)) {
    range = 'all';
    tabs.forEach((x) => x.classList.toggle('on', x.dataset.range === 'all'));
    apply();
  }
</script>
