---
/**
 * 開催月の一覧（/when/）
 *
 * 月のページへの入口。フッタから全ページから辿れるようにしてある
 * （内部リンクが太いページほど先にクロールされる。被リンクがゼロのうちは
 * これが数少ない打ち手）。
 */
import Base from '../../layouts/Base.astro';
import { loadFestivals } from '../../lib/data.js';
import { SITE_NAME } from '../../lib/site.js';

const all = loadFestivals();
const today = new Date().toISOString().slice(0, 10);
const thisMonth = today.slice(0, 7);

const byMonth = new Map();
for (const f of all) {
  const seen = new Set();
  for (const o of f.occurrences ?? []) {
    for (const d of o.dates ?? []) {
      const m = String(d).slice(0, 7);
      if (!/^\d{4}-\d{2}$/.test(m) || seen.has(m)) continue;
      seen.add(m);
      byMonth.set(m, (byMonth.get(m) ?? 0) + 1);
    }
  }
}
// [month].astro と同じ条件。ページの無い月をリンクにしない
const fromYear = `${new Date().getFullYear()}-01`;
const months = [...byMonth].filter(([m, n]) => m >= fromYear && n >= 20).sort();
const total = all.length;
const upcoming = months.filter(([m]) => m >= thisMonth).reduce((a, [, n]) => a + n, 0);

const labelOf = (m) => `${m.slice(0, 4)}年${Number(m.slice(5))}月`;

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: SITE_NAME, item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: '開催月から探す', item: new URL('/when/', Astro.site).href },
  ],
};
---

<Base
  title="開催月から祭りを探す"
  description={`掲載 ${total.toLocaleString()} 件の祭り・盆踊り・花火大会を開催月から探せます。これから開催されるものは ${upcoming.toLocaleString()} 件。`}
  jsonld={jsonld}
>
  <nav class="crumb"><a href="/">{SITE_NAME}</a> ／ 開催月から探す</nav>
  <h1>開催月から探す</h1>
  <p class="summary">
    掲載している {total.toLocaleString()} 件のうち、これから開催されるものは
    {upcoming.toLocaleString()} 件です。月を選ぶと、その月に開催される祭りと、
    開催が多い日がわかります。
  </p>

  <ul class="months">
    {months.map(([m, n]) => (
      <li class={m === thisMonth ? 'now' : ''}>
        <a href={`/when/${m}/`}>
          <span class="m">{labelOf(m)}</span>
          <span class="c">{n.toLocaleString()}件</span>
          {m === thisMonth && <span class="tag">今月</span>}
        </a>
      </li>
    ))}
  </ul>

  <p class="lede">
    日付や名前でしぼって探すときは <a href="/search">さがす</a> から。
    地域から辿るときは <a href="/">トップの都道府県一覧</a> を使ってください。
  </p>

  <style>
    .crumb { font-size: 13px; color: var(--muted); margin: 20px 0 0; }
    h1 { margin-top: 4px; }
    .summary { font-size: 15px; line-height: 1.9; margin: 12px 0; }
    .lede { color: var(--muted); font-size: var(--t4); margin-top: 28px; }
    .months {
      list-style: none; padding: 0; margin: 20px 0;
      display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px;
    }
    .months a {
      display: flex; flex-direction: column; gap: 2px;
      border: 1px solid var(--line); border-radius: var(--r2); background: var(--card);
      padding: 12px 14px; text-decoration: none; color: inherit;
    }
    .months .now a { border-color: var(--akane); background: var(--card2); }
    .months .m { font-size: var(--t5); font-weight: 700; }
    .months .c { font-size: var(--t2); color: var(--muted); }
    .months .tag {
      align-self: flex-start; margin-top: 4px; font-size: var(--t1);
      color: #fff; background: var(--akane); border-radius: var(--r1); padding: 1px 6px;
    }
  </style>
</Base>
