---
import Base from '../../layouts/Base.astro';
import Ad from '../../components/Ad.astro';
import { SITE_NAME } from '../../lib/site.js';
import { loadFestivals, latestOccurrence, formatDates, formatTime, STATUS_LABEL, staleDays, locators } from '../../lib/data.js';
import { festivalSummary, festivalMetaDescription } from '../../lib/festival-summary.js';

export function getStaticPaths() {
  const all = loadFestivals();
  const today = new Date().toISOString().slice(0, 10);

  // 同じ市区町村に同じ名前の祭りが何件あるかを先に数える。
  // 1 件しかないものは地名を細かくする必要がない
  const groups = new Map();
  for (const f of all) {
    const k = `${f.area.city}${f.area.ward ?? ''}|${f.name}`;
    groups.set(k, (groups.get(k) ?? 0) + 1);
  }
  // 衝突している組の中で、どこまで細かくすれば全員バラバラになるかを決める
  // 衝突している組だけを集める。`locators()` は 1 件につき 1 回しか呼ばない
  const peersOf = new Map();
  for (const f of all) {
    const k = `${f.area.city}${f.area.ward ?? ''}|${f.name}`;
    if (groups.get(k) === 1) continue;
    if (!peersOf.has(k)) peersOf.set(k, []);
    peersOf.get(k).push(f);
  }
  const candOf = new Map();
  for (const list of peersOf.values()) for (const f of list) candOf.set(f.id, locators(f));

  const whereOf = new Map();
  for (const f of all) {
    const k = `${f.area.city}${f.area.ward ?? ''}|${f.name}`;
    if (groups.get(k) === 1) { whereOf.set(f.id, locators(f)[0]); continue; }
    const cand = candOf.get(f.id);
    const peers = peersOf.get(k);
    // 粗い方から試して、その粒度で自分だけになる最初のものを使う
    const lv = [1, 2, 3].find((i) =>
      peers.filter((x) => candOf.get(x.id)[i] === cand[i]).length === 1);
    whereOf.set(f.id, cand[lv ?? 1]);
  }

  /**
   * 同じ市区町村ごとに先に束ねておく。
   *
   * **1 件ごとに全件を filter していた。** 5,000 件なら 2,500 万回の走査になり、
   * ページが増えるほど二乗で効いてくる。ビルドが 10 分を超えてきたのはこれが一因。
   * Cloudflare Pages のビルドは 20 分で打ち切られるので、ここは効く。
   */
  const nearbyOf = new Map();
  for (const x of all) {
    const k = `${x._prefSlug}/${x._citySlug}/${x.area.ward ?? ''}`;
    if (!nearbyOf.has(k)) nearbyOf.set(k, []);
    nearbyOf.get(k).push(x);
  }

  return all.map((f) => {
    // 同じ市区町村の他の祭り。1 件見た人は「近所で他に何かないか」を知りたい。
    // これが無いと詳細ページが行き止まりになる
    const nearby = (nearbyOf.get(`${f._prefSlug}/${f._citySlug}/${f.area.ward ?? ''}`) ?? [])
      .filter((x) => x.id !== f.id)
      .map((x) => {
        const o = [...(x.occurrences ?? [])].sort((a, b) => b.year - a.year)[0];
        return { x, next: (o?.dates ?? []).find((d) => d >= today) ?? null, o };
      })
      // これから開催されるものを先に、日付の近い順
      .sort((a, b) => (a.next ?? '9999').localeCompare(b.next ?? '9999'))
      .slice(0, 8);

    return { params: { id: f.id }, props: { f, nearby, where: whereOf.get(f.id) } };
  });
}

// 出典の格を見えるようにする。まとめサイト由来のものを一次情報に置き換えていく作業の進捗が、
// そのままユーザーへの信頼性の表示になる。
const SOURCE_TIER = {
  official: '主催者の公式発表',
  gov: '行政の発表',
  media: '地域メディア',
  aggregator: 'まとめサイト',
};

const { f, nearby, where } = Astro.props;
const occ = latestOccurrence(f);
const past = [...(f.occurrences ?? [])].sort((a, b) => b.year - a.year).slice(1);
const thisYear = new Date().getFullYear();

const isCurrentYear = occ?.year === thisYear;
const statusLabel = STATUS_LABEL[occ?.status] ?? null;
const stale = staleDays(occ);

// 住所が取れていない祭りが多いので、その場合は市区名で補って地図を引く
// 区が無い市では ward が null。そのまま繋ぐと「茂原市null」という地図検索になる
// 会場名が既に市名で始まることがある（「東海市中央町大池公園内」）。
// そのまま前置すると「東海市 東海市中央町…」になり、地図が引きにくくなる
//
// **住所が無いときは緯度経度を使う。** 記事の地図埋め込みから起こした座標を
// 1,290 件持っているのに、地図リンクが住所と会場名しか見ていなかった。
// うち 189 件は住所が無く、「市区名＋会場名」という当てにならない語で
// 地図を引いていた。座標があるならそれが一番正確。
const mapQuery = f.venue.address
  ?? (f.venue.lat != null ? `${f.venue.lat},${f.venue.lng}` : null)
  ?? (f.venue.name?.startsWith(f.area.city)
    ? f.venue.name
    : `${f.area.city}${f.area.ward ?? ''} ${f.venue.name}`);
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;

// Google のイベント検索に載せるための構造化データ。
// 日程が確定していない回は出さない（誤情報を配信しないため）。
const jsonld =
  occ?.dates?.length && occ.status !== 'unconfirmed'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Event',
        name: f.name,
        startDate: occ.start_time ? `${occ.dates[0]}T${occ.start_time}:00+09:00` : occ.dates[0],
        endDate: occ.end_time
          ? `${occ.dates.at(-1)}T${occ.end_time}:00+09:00`
          : occ.dates.at(-1),
        eventStatus:
          occ.status === 'cancelled'
            ? 'https://schema.org/EventCancelled'
            : occ.status === 'postponed'
              ? 'https://schema.org/EventPostponed'
              : 'https://schema.org/EventScheduled',
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        location: {
          '@type': 'Place',
          name: f.venue.name,
          address: {
            '@type': 'PostalAddress',
            addressCountry: 'JP',
            addressRegion: f.area.pref,
            addressLocality: `${f.area.city}${f.area.ward ?? ''}`,
            streetAddress: f.venue.address ?? f.venue.name,
          },
        },
        ...(f.organizer ? { organizer: { '@type': 'Organization', name: f.organizer } } : {}),
        /**
         * **入場無料と言い切れるものだけ言う。**
         * 町内会の盆踊り・神社の例祭で入場料を取ることは実質ないので断定してよいが、
         * **花火大会には有料観覧席がある**。確かめていないものは黙る
         * （`paid_seats` が `no` と確認できたものだけ無料と申告する）。
         */
        ...(f.kind === '花火' || /花火/.test(f.name)
          ? (f.paid_seats === 'no' ? { isAccessibleForFree: true } : {})
          : { isAccessibleForFree: true }),
        // **画像と説明が無いと Search Console が警告を出す**（Event の推奨項目）。
        // 写真があるものは 184 件しかないので、無いときはサイトの既定の画像を使う。
        // 説明は本文と同じものを渡す（別の文を作ると食い違う）
        image: [f.photos?.[0]?.url ?? new URL('/ogp.png', Astro.site).href],
        description: festivalMetaDescription(f),
        url: new URL(Astro.url.pathname, Astro.site).href,
      }
    : null;

/**
 * **同じ名前の祭りが全国に山ほどある**（「稲荷神社 例祭」は 69 件）。
 * 題名を名前だけにすると 604 ページが同じ題名になり、検索側からは
 * 区別が付かない。地名を頭に付けて一意にする。
 * 名前に既に地名が入っているとき（「藤沢宿・遊行の盆」など）は重ねない。
 */
const place = `${f.area.city}${f.area.ward ?? ''}`;
const bare = place.replace(/[市区町村]$/, '');
// where（題名に付ける地名）は getStaticPaths 側で、同名の祭りと
// 区別が付く粒度まで細かくしたものが渡ってくる。`locators()` を参照
const title = f.name.includes(bare)
  ? `${f.name}｜${occ?.year}年の日程`
  : `${where} ${f.name}｜${occ?.year}年の日程`;

// 本文の説明文。表と出典しか無いページに文章を持たせる（`festival-summary.js` 参照）。
// meta description も、本文と食い違わないよう同じ文の冒頭から作る。
// 以前は独自に組み立てていたが、屋台が unknown のとき何も言わない・
// 日程が推定でも確定のように読める、という問題が本文と二重に起きるので一本化した
const summary = festivalSummary(f);
const desc = festivalMetaDescription(f);
---

<Base title={title} description={desc} jsonld={jsonld} image={f.photos?.[0]?.url}>
  <nav class="crumb">
    <a href="/">{SITE_NAME}</a> ／
    <a href={`/a/${f._prefSlug}/`}>{f.area.pref}</a> ／
    <a href={`/a/${f._prefSlug}/${f._citySlug}/`}>{f.area.city}</a>
    {f.area.ward && <> {f.area.ward}</>} ／ {f.kind}
  </nav>
  <h1>{f.name}</h1>

  {summary && <p class="summary">{summary}</p>}

  {!isCurrentYear && (
    <p class="notice">
      {thisYear}年の開催情報はまだ確認できていません。以下は <strong>{occ?.year}年</strong> の実績です。
      例年おなじ時期に開催されることが多いですが、日程は毎年変わります。
    </p>
  )}
  {statusLabel && <p class="notice">この開催回は「{statusLabel}」の扱いです。</p>}

  {f.photos?.length > 0 && (
    <div class="photos">
      {f.photos.map((ph) => (
        <figure>
          <img src={ph.url} alt={`${f.name}の写真`} loading="lazy" width={ph.width} height={ph.height} />
          <figcaption>
            撮影: {ph.credit} ／ <a href={ph.license_url ?? ph.source} target="_blank" rel="noopener">{ph.license}</a>
            {' '}<a href={ph.source} target="_blank" rel="noopener">出典</a>
          </figcaption>
        </figure>
      ))}
    </div>
  )}

  {/* 短冊の事実表。行ごとに見出しの帯を立てる。
      屋台の行だけは提灯色で灯す —— このサイトを使う一番の理由がそこにあるので、
      表の中に埋もれさせない */}
  <dl class="facts">
    <div class="fact big">
      <dt>日程</dt>
      <dd>{formatDates(occ)}{occ?.year && <span class="y">（{occ.year}年）</span>}</dd>
    </div>
    {formatTime(occ) && <div class="fact"><dt>時間</dt><dd>{formatTime(occ)}</dd></div>}
    <div class="fact">
      <dt>会場</dt>
      <dd>
        {f.venue.name}
        {f.venue.address && <><br /><span class="addr">{f.venue.address}</span></>}
        <br /><a href={mapUrl} target="_blank" rel="noopener">地図で見る</a>
      </dd>
    </div>
    {f.recurrence && (
      <div class="fact">
        <dt>例祭日</dt>
        <dd>
          毎年 {f.recurrence}
          {f.recurrence_source && (
            <> <a href={f.recurrence_source} target="_blank" rel="noopener">出典</a></>
          )}
        </dd>
      </div>
    )}
    <div class:list={['fact', 'stalls', f.stalls !== 'yes' && 'quiet']}>
      <dt>屋台・露店</dt>
      <dd>
        {f.stalls === 'yes' ? '出ます'
          : f.stalls === 'no' ? '出ません（神事のみ）'
            : '未確認。出典元や神社にご確認ください'}
      </dd>
    </div>
    {(f.kind === '花火' || /花火/.test(f.name)) && (
      <div class="fact">
        <dt>有料席</dt>
        <dd>
          {f.paid_seats === 'yes' ? '有料観覧席があります'
            : f.paid_seats === 'no' ? '有料席はありません（どこからでも無料で見られます）'
              : <span class="unknown">未確認。主催者の発表をご確認ください</span>}
          {f.paid_seats_note && <span class="note">{f.paid_seats_note}</span>}
        </dd>
      </div>
    )}
    {f.station && <div class="fact"><dt>最寄駅</dt><dd>{f.station}</dd></div>}
    {f.organizer && <div class="fact"><dt>主催</dt><dd>{f.organizer}</dd></div>}
    {f.shrine && <div class="fact"><dt>神社</dt><dd>{f.shrine}</dd></div>}
    <div class="fact"><dt>規模</dt><dd>{f.scale === '市' ? '市町村全体' : f.scale}</dd></div>
    {f.tags?.length > 0 && <div class="fact"><dt>特徴</dt><dd>{f.tags.join('・')}</dd></div>}
    {occ?.note && <div class="fact"><dt>備考</dt><dd>{occ.note}</dd></div>}
  </dl>
  {f.description && <p>{f.description}</p>}

  <h2>この情報について</h2>
  <ul class="source">
    <li>
      出典：<a href={occ?.source_url} target="_blank" rel="noopener">{occ?.source_name ?? occ?.source_url}</a>
      {SOURCE_TIER[occ?.source_type] && (
        <span class={`badge ${occ.source_type === 'official' ? '' : 'muted'}`}>
          {SOURCE_TIER[occ.source_type]}
        </span>
      )}
    </li>
    <li>最終確認：{occ?.checked_at}{stale > 180 && <span class="badge warn">確認から{stale}日</span>}</li>
  </ul>
  {(occ?.source_type === 'media' || occ?.source_type === 'aggregator') && (
    <p class="disclaimer">
      これは主催者の発表そのものではなく、報道やまとめ記事から拾った情報です。
      主催者の一次情報が見つかり次第そちらに差し替えます。
    </p>
  )}
  <p class="disclaimer">
    日時・場所は出典元の発表にもとづいて掲載しています。変更や中止の可能性があるため、
    おでかけ前に主催者・出典元の最新情報をご確認ください。誤りに気づいた方はご連絡いただけると助かります。
  </p>

  {f.links?.length > 0 && (
    <>
      <h2>関連リンク</h2>
      <ul class="source">
        {/* 素の URL 文字列と {title,url} の 2 通りが混ざっている */}
        {f.links.map((l) => {
          const url = typeof l === 'string' ? l : l.url;
          const label = typeof l === 'string' ? l : (l.title ?? l.url);
          return <li><a href={url} target="_blank" rel="noopener">{label}</a></li>;
        })}
      </ul>
    </>
  )}

  {past.length > 0 && (
    <>
      <h2>過去の開催</h2>
      <ul class="source">
        {past.map((o) => <li>{o.year}年：{formatDates(o)}</li>)}
      </ul>
    </>
  )}

  {nearby.length > 0 && (
    <>
      <h2>{f.area.ward ?? f.area.city}の他の祭り</h2>
      <ul class="nearby">
        {nearby.map(({ x, next, o }) => (
          <li>
            <a href={`/f/${x.id}/`}>
              <span class="n">{x.name}</span>
              <span class="d">{formatDates(o) || '日程未確認'}</span>
            </a>
            {x.stalls === 'yes' && <span class="badge stalls">屋台あり</span>}
            {!next && <span class="past">終了</span>}
          </li>
        ))}
      </ul>
      <p><a href={`/a/${f._prefSlug}/${f._citySlug}/`}>{f.area.city}の祭りをすべて見る →</a></p>
    </>
  )}

  <Ad />

  <p style="margin-top:32px"><a href={`/a/${f._prefSlug}/${f._citySlug}/`}>← {f.area.city}の一覧にもどる</a></p>

  <style>
    .crumb { font-size: var(--t2); color: var(--muted); margin: var(--s4) 0 0; line-height: 1.6; word-break: break-word; }
    h1 { margin-top: var(--s1); }
    /* 本文の説明文。表より前に読むものなので、表と同じ大きさで行間だけ広げる */
    .summary { font-size: var(--t4); line-height: 1.9; margin: var(--s3) 0; }
    .notice {
      display: flex; gap: var(--s2);
      background: var(--warn-bg); color: var(--warn-fg);
      border: 1px solid var(--warn-line); border-left-width: 5px;
      padding: var(--s2) var(--s3); border-radius: var(--r2);
      font-size: var(--t3); line-height: 1.6; margin: var(--s3) 0;
    }
    .facts {
      margin: var(--s3) 0; border: 1px solid var(--line); border-radius: var(--r2);
      overflow: hidden; background: var(--card);
    }
    .fact { display: flex; border-bottom: 1px solid var(--line2); font-size: var(--t4); }
    .fact:last-child { border-bottom: 0; }
    .fact > dt {
      flex: 0 0 84px; width: 84px; padding: var(--s2) var(--s3);
      font-size: var(--t2); color: #fff; font-weight: 700; letter-spacing: .08em;
      background: var(--ai); display: flex; align-items: flex-start;
    }
    @media (prefers-color-scheme: dark) { .fact > dt { color: #0f1420; } }
    .fact > dd { margin: 0; padding: var(--s2) var(--s3); flex: 1; min-width: 0; word-break: break-word; }
    .fact .addr { display: block; font-size: var(--t2); color: var(--muted); }
    .fact .y { font-size: var(--t2); color: var(--muted); font-weight: 400; }
    .fact.big > dd { font-size: var(--t5); font-weight: 700; line-height: 1.5; }
    /* 屋台の行。行ごと灯す */
    .fact.stalls > dt { background: var(--stall); color: #2a1c05; }
    .fact.stalls { background: linear-gradient(90deg, var(--glow), transparent 70%); }
    .fact.stalls > dd { font-weight: 800; color: var(--stall); font-size: var(--t5); }
    .fact.stalls.quiet { background: none; }
    .fact.stalls.quiet > dt { background: var(--muted); color: var(--card); }
    .fact.stalls.quiet > dd { font-weight: 500; color: var(--muted); font-size: var(--t4); }
    .photos { display: grid; gap: var(--s3); margin: var(--s4) 0; }
    .photos figure { margin: 0; }
    .photos img { width: 100%; height: auto; border-radius: var(--r2); display: block; background: var(--card); }
    .photos figcaption { font-size: var(--t2); color: var(--muted); margin-top: var(--s1); }
    .nearby { list-style: none; padding: 0; margin: var(--s2) 0; font-size: var(--t4); }
    .nearby li {
      display: flex; align-items: baseline; gap: var(--s2); flex-wrap: wrap;
      border-bottom: 1px solid var(--line2); padding: var(--s2) 2px;
    }
    .nearby a { display: flex; gap: var(--s2); flex: 1; min-width: 0; align-items: baseline; text-decoration: none; color: inherit; }
    .nearby a:hover .n { text-decoration: underline; }
    .nearby .n { flex: 1; min-width: 0; }
    .nearby .d { color: var(--muted); font-size: var(--t2); white-space: nowrap; }
    .nearby .past { color: var(--muted); font-size: var(--t1); }
    /* 出典帯。全ページの下端に必ず出す */
    .source {
      font-size: var(--t3); margin: var(--s3) 0; padding: var(--s2) var(--s3) var(--s2) var(--s5);
      border: 1px solid var(--line); border-left: 5px solid var(--ai);
      border-radius: var(--r2); background: var(--card);
    }
    .source li { margin-bottom: var(--s1); word-break: break-all; }
    .disclaimer { font-size: var(--t2); color: var(--muted); line-height: 1.7; }
    /* 狭い画面では見出しの帯が本文を圧迫する。住所や備考は長い */
    @media (max-width: 430px) {
      .fact > dt { flex: 0 0 66px; width: 66px; padding: var(--s2); letter-spacing: 0; }
      .fact > dd { padding: var(--s2); }
    }
  </style>
</Base>
