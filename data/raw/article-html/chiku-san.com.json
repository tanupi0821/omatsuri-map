p-16912934472773774067510593722911-2048x1536.jpg 2048w, http://chiku-san.com/wp-content/uploads/2023/08/wp-16912934472773774067510593722911-scaled.jpg 856w\" sizes=\"auto, (max-width: 2560px) 100vw, 2560px\" />\n<img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-29388\" src=\"http://chiku-san.com/wp-content/uploads/2023/08/wp-16912934466463557033731176899362-scaled.jpg\" alt=\"\" width=\"2560\" height=\"1920\" srcset=\"https://chiku-san.com/wp-content/uploads/2023/08/wp-16912934466463557033731176899362-scaled.jpg 2560w, https://chiku-san.com/wp-content/uploads/2023/08/wp-16912934466463557033731176899362-300x225.jpg 300w, https://chiku-san.com/wp-content/uploads/2023/08/wp-16912934466463557033731176899362-1024x768.jpg 1024w, https://chiku-san.com/wp-content/uploads/2023/08/wp-16912934466463557033731176899362-768x576.jpg 768w, https://chiku-san.com/wp-content/uploads/2023/08/wp-16912934466463557033731176899362-1536x1152.jpg 1536w, https://chiku-san.com/wp-content/uploads/2023/08/wp-16912934466463557033731176899362-2048x1536.jpg 2048w, http://chiku-san.com/wp-content/uploads/2023/08/wp-16912934466463557033731176899362-scaled.jpg 856w\" sizes=\"auto, (max-width: 2560px) 100vw, 2560px\" /> <img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-29391\" src=\"http://chiku-san.com/wp-content/uploads/2023/08/wp-16912934460374000141872858486653-scaled.jpg\" alt=\"\" width=\"2560\" height=\"1920\" srcset=\"https://chiku-san.com/wp-content/uploads/2023/08/wp-16912934460374000141872858486653-scaled.jpg 2560w, https://chiku-san.com/wp-content/uploads/2023/08/wp-16912934460374000141872858486653-300x225.jpg 300w, https://chiku-san.com/wp-content/uploads/2023/08/wp-16912934460374000141872858486653-1024x768.jpg 1024w, https://chiku-san.com/wp-content/uploads/2023/08/wp-16912934460374000141872858486653-768x576.jpg 768w, https://chiku-san.com/wp-content/uploads/2023/08/wp-16912934460374000141872858486653-1536x1152.jpg 1536w, https://chi