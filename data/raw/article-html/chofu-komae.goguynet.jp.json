4; flex-grow: 0; height: 12px; width: 16px; transform: translateY(-4px);\"></div>\n<div style=\" width: 0; height: 0; border-top: 8px solid #F4F4F4; border-left: 8px solid transparent; transform: translateY(-4px) translateX(8px);\"></div>\n</div>\n</div>\n<div style=\"display: flex; flex-direction: column; flex-grow: 1; justify-content: center; margin-bottom: 24px;\">\n<div style=\" background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; margin-bottom: 6px; width: 224px;\"></div>\n<div style=\" background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; width: 144px;\"></div>\n</div>\n<p></a></div>\n</blockquote>\n<p><script async src=\"//platform.instagram.com/en_US/embeds.js\"></script></p>\n<p>当日の出店者として、施設内からは文房具販売の「Paper&amp;Print」やそば粉発酵菓子の「八花」、パーソナルジム「Re:glow」、まつげサロン「eyelash La・La・La」、整体院「はるかぜ」、惣菜・スイーツの「micro DELI＆SHOP」、瓦そば・おばんざいの「一凜」が参加します。さらに外部からも、かき氷や玉こんにゃくを販売する「cheers company」、ベトナム風野菜まぜそばの「sarusun」、濃厚ジンジャーエールの「ジンジャー神社」、タロット占い、地元野菜の「相田農園」、韓国チキンの「チキンイムニダ」、横手やきそばの「キッチンカー栄屋」、スーパーボールすくいを行う「小田急バス」など多彩なコンテンツが揃います。</p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-32566\" src=\"https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2026/07/f0dedd8111d15d02fe240f8f03b89d2b.png\" alt=\"\" width=\"814\" height=\"517\" srcset=\"https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2026/07/f0dedd8111d15d02fe240f8f03b89d2b.png 814w, https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2026/07/f0dedd8111d15d02fe240f8f03b89d2b-768x488.png 768w\" sizes=\"auto, (max-width: 814px) 100vw, 814px\" /></p>\n<p>イベント当日は混雑緩和のため、敷地内に駐車場および駐輪場は設けられないため、公共交通機関での来場が呼びかけられています。アクセスは京王線調布駅北口からバスで12分、中央線三鷹駅南口からバスで28分、または京王線つつじヶ丘駅から徒歩26分となっています。</p>\n<p>夏の風情を感じながら地域の魅力に触れられる機会として、散歩や涼みに行かれてみてはいかがでしょうか。詳細な情報は公式Instagramにて随時更新されています。</p>\n"
  },
  {
   "id": 32522,
   "url": "https://chofu-komae.goguynet.jp/2026/06/26/post-32522/",
   "date": "2026-06-26",
   "title": "【調布市】イトーヨーカドー国領店の専門店街で特別企画！6月27日・28日の2日間限定で「納涼こんにゃくゼリー」のプレゼントが実施されます！",
   "html": "<p>イトーヨーカドー国領店の専門店街にて、夏の特別企画「夏のザ・フェスタ 納涼こんにゃくゼリープレゼント」が開催されます 。開催期間は2026年6月27日（土）と6月28日（日）の2日間限定となっており、各日とも開店時刻からスタートします。</p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-32523\" src=\"https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2026/06/IMG_3221.jpeg\" alt=\"\" width=\"1280\" height=\"720\" srcset=\"https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2026/06/IMG_3221.jpeg 1280w, https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2026/06/IMG_3221-768x432.jpeg 768w\" sizes=\"auto, (max-width: 1280px) 100vw, 1280px\" /></p>\n<p>このイベントは、対象の専門店でお買い物をされた方、または各店舗を利用された方を対象に、暑い季節にぴったりのこんにゃくゼリーが1本プレゼントされるという企画です。</p>\n<p>店頭のポスターによると、用意されているゼリーの味はグレープ、パイン、サイダー、ストロベリーの4種類となっています。冷やしても凍らせても美味しく食べられる仕様になっており、これからの季節に嬉しいノベルティです。</p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-32320\" src=\"https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2026/05/IMG_3557-1.jpeg\" alt=\"\" width=\"1280\" height=\"960\" srcset=\"https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2026/05/IMG_3557-1.jpeg 1280w, https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2026/05/IMG_3557-1-768x576.jpeg 768w, https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2026/05/IMG_3557-1-1024x767.jpeg 1024w\" sizes=\"auto, (max-width: 1280px) 100vw, 1280px\" /></p>\n<p>配布場所は各専門店の店頭となっており、数量限定のため、それぞれの店舗で用意された数がなくなり次第終了となります。今週末にイトーヨーカドー国領店の専門店街でお買い物やサービスを利用される方は、店頭の案内を確認してみてはいかがでしょうか。</p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-32329\" src=\"https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2026/05/IMG_2720.jpeg\" alt=\"\" width=\"1280\" height=\"720\" srcset=\"https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2026/05/IMG_2720.jpeg 1280w, https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2026/05/IMG_2720-768x432.jpeg 768w\" sizes=\"auto, (max-width: 1280px) 100vw, 1280px\" /></p>\n<p>また、ヨーカドー国領店では、7月1日～3日まで店休日となります。<br />\nご利用の方はご注意ください。</p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-31333\" src=\"https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2025/11/7a903633ba5fd3f1e35a4f5f05b8f791.png\" alt=\"\" width=\"952\" height=\"547\" srcset=\"https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2025/11/7a903633ba5fd3f1e35a4f5f05b8f791.png 952w, https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2025/11/7a903633ba5fd3f1e35a4f5f05b8f791-768x441.png 768w\" sizes=\"auto, (max-width: 952px) 100vw, 952px\" /></p>\n"
  },
  {
   "id": 32511,
   "url": "https://chofu-komae.goguynet.jp/2026/06/23/post-32511/",
   "date": "2026-06-23",
   "title": "【調布市】野ヶ谷諏訪神社で「納涼盆踊り大会」が2026年7月17日と18日に開催されます！子ども達が練習を重ねた太鼓の音色が響く2日間",
   "html": "<p>東京都調布市深大寺東町にある野ヶ谷諏訪神社の境内にて、「納涼盆踊り大会」が開催されることが分かりました。開催日時は2026年7月17日（金）と7月18日（土）の2日間で、両日ともに午後6時から午後9時までの時間帯で行われます。</p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-32513\" src=\"https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2026/06/IMG_3183.jpeg\" alt=\"\" width=\"1280\" height=\"960\" srcset=\"https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2026/06/IMG_3183.jpeg 1280w, https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2026/06/IMG_3183-768x576.jpeg 768w, https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2026/06/IMG_3183-1024x767.jpeg 1024w\" sizes=\"auto, (max-width: 1280px) 100vw, 1280px\" /></p>\n<p>当日は、子ども達が一生懸命に練習を重ねてきた太鼓の音色が境内に響き渡り、地域の夏を賑やかに盛り上げます。主催は野ヶ谷青年会で、現在「新会員募集中」とのことです。また、野ヶ谷諏訪神社氏子や、JAマインズ野ヶ谷支部女性部が協力としてこの地域イベントを支えています。</p>\n<div id=\"attachment_30784\" style=\"width: 1290px\" class=\"wp-caption alignnone\"><img loading=\"lazy\" decoding=\"async\" aria-describedby=\"caption-attachment-30784\" class=\"size-full wp-image-30784\" src=\"https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2025/07/32852855_l.jpg\" alt=\"\" width=\"1280\" height=\"961\" srcset=\"https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2025/07/32852855_l.jpg 1280w, https://chofu-komae.goguynet.jp/wp-content/uploads/sites/117/2025/07/32852855_l-768x577.jpg 768w\" sizes=\"auto, (max-width: 1280px) 100vw, 1280px\" /><p id=\"caption-attachment-30784\" class=\"wp-caption-text\">画像はイメージです</p></div>\n<p>会場となる野ヶ谷諏訪神社へのアクセスについては、自転車での来場は控えるよう案内が出されています。近隣にお住まいの方や、地元の夏の風物詩を楽しみたい方は、この機会に足を運んでみてはいかがでしょうか。</p>\n"
  },
  {
   "id": 32494,
   "url": "https://chofu-komae.goguynet.jp/2026/06/18/post-32494/",
   "date": "2026-06-18",
   "title": "【調布市】布多天神社で6月25日に「夏越大祓・長寿蕎麦祭り」が開催されます！境内ライトアップや蕎麦の振る舞いも",
   "html": "<p>調布市ヶ谷に鎮座する布多天神社にて、2026年6月25日（木）に「夏越大祓・長寿蕎麦祭り」が開催されます。夏越大祓（なごしのおおはらえ）は、半年間のうちに日常生活で知らず知らずのうちに犯した罪や心身の穢れを祓い清め、残り半年の無病息災を祈る日本の伝統的な神事です。布多天神社では、当日の朝から境内に設置された大きな「茅の輪（ちのわ）」をくぐる茅の輪くぐりを行うことができます。</p>\n<blockquote class=\"instagram-media\" data-instgrm-captioned data-instgrm-permalink=\"https://www.instagram.com/p/DZMRbl8nabk/?utm_source=ig_embed&amp;utm_campaign=loading\" data-instgrm-version=\"14\" style=\" background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin: 1px; max-width:500px; min-width:326px; padding:0; width:99.375%; width:-webkit-calc(100% - 2px); width:calc(100% - 2px);\">\n<div style=\"padding:16px;\"> <a href=\"https://www.instagram.com/p/DZMRbl8nabk/?utm_source=ig_embed&amp;utm_campaign=loading\" style=\" background:#FFFFFF; line-height:0; padding:0 0; text-align:center; text-decoration:none; width:100%;\" target=\"_blank\"> </p>\n<div style=\" display: flex; flex-direction: row; align-items: center;\">\n<div style=\"background-color: #F4F4F4; border-radius: 50%; flex-grow: 0; height: 40px; margin-right: 14px; width: 40px;\"></div>\n<div style=\"display: flex; flex-direction: column; flex-grow: 1; justify-content: center;\">\n<div style=\" background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; margin-bottom: 6px; width: 100px;\"></div>\n<div style=\" background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; width: 60px;\"></div>\n</div>\n</div>\n<div style=\"padding: 19% 0;\"></div>\n<div style=\"display:block; height:50px; margin:0 auto 12px; width:50px;\"><svg width=\"50px\" height=\"50px\" viewBox=\"0 0 60 60\" version=\"1.1\" xmlns=\"https://www.w3.org/2000/svg\" xmlns:xlink=\"https://www.w3.org/1999/xlink\"><g stroke=\"none\" stroke-width=\"1\" fill=\"none\" fill-rule=\"evenodd\"><g transform=\"translate(-511.000000, -20.000000)\" fill=\"#000000\"><g><path d=\"M556.869,30.41 C554.814,30.41 553.148,32.076 553.148,34.131 C553.148,36.186 55